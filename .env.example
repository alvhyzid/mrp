NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hook secret for Supabase Auth custom access token hook.
# Use the full Standard Webhooks secret, e.g. v1,whsec_<base64-secret>
CUSTOM_ACCESS_TOKEN_HOOK_SECRETS=v1,whsec_<base64-secret>

# Passwords for local debug/seed accounts only (not real user credentials).
# Used by scripts/seed-*.js, scripts/test-super-admin.js and tests/super_admin.test.ts.
DEBUG_COMPANY_A_PASSWORD=your-debug-company-a-password
DEBUG_COMPANY_B_PASSWORD=your-debug-company-b-password
DEBUG_COMPANY_A_STAFF_PASSWORD=your-debug-company-a-staff-password
DEBUG_COMPANY_A_APPROVER_PASSWORD=your-debug-company-a-approver-password
DEBUG_SUPER_ADMIN_PASSWORD=your-debug-super-admin-password

# Used by tests/role_hierarchy_financial_access.test.ts (self-cleaning role/RLS fixtures).
DEBUG_ROLE_TEST_PASSWORD=your-debug-role-test-password
